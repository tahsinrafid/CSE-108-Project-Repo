<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.examsystemproject.AboutUsController"
            prefHeight="700.0" prefWidth="1000.0"
            styleClass="about-root">
    <stylesheets>
        <URL value="@aboutUs.css" />
    </stylesheets>

    <children>
        <Circle fx:id="glowOne" centerX="120.0" centerY="130.0" radius="170.0" styleClass="glow glow-a" />
        <Circle fx:id="glowTwo" centerX="880.0" centerY="190.0" radius="210.0" styleClass="glow glow-b" />
        <Circle fx:id="glowThree" centerX="700.0" centerY="610.0" radius="190.0" styleClass="glow glow-c" />

        <AnchorPane prefHeight="78.0" prefWidth="1000.0" styleClass="top-bar">
            <children>
                <Label layoutX="34.0" layoutY="24.0" text="ExamAce" styleClass="brand" />
                <Label layoutX="190.0" layoutY="35.0" text="About Us" styleClass="brand-sub" />
                <Button layoutX="843.0" layoutY="20.0"
                        text="Back to Dashboard"
                        onAction="#onBackToDashboard"
                        mnemonicParsing="false"
                        styleClass="back-btn" />
            </children>
        </AnchorPane>

        <ScrollPane layoutX="90.0" layoutY="98.0" prefWidth="820.0" prefHeight="580.0" fitToWidth="true" hbarPolicy="NEVER" styleClass="about-scroll">
            <content>
                <VBox fx:id="contentCard" prefWidth="800.0" prefHeight="980.0" styleClass="content-card" spacing="18.0">
                    <padding>
                        <Insets top="34.0" right="36.0" bottom="34.0" left="36.0" />
                    </padding>
                    <children>
                        <Label text="Built for Better Exams" styleClass="hero-title" />
                        <Label text="ExamAce helps students and teachers run smarter assessments with clarity, speed, and confidence."
                               wrapText="true" styleClass="hero-sub" />

                        <HBox spacing="12.0" styleClass="chip-row">
                            <children>
                                <Label text="JavaFX" styleClass="chip" />
                                <Label text="Fast Results" styleClass="chip" />
                                <Label text="Teacher + Student" styleClass="chip" />
                            </children>
                        </HBox>

                        <VBox spacing="8.0" styleClass="message-block">
                            <children>
                                <Label text="Short Message" styleClass="value-title" />
                                <TextArea wrapText="true" prefRowCount="3" styleClass="message-editor"
                                          text="We are building ExamAce to make exam experiences calm, fair, and easy for every student and teacher."
                                          promptText="Write a short About Us message here and update it anytime." />
                            </children>
                        </VBox>

                        <Rectangle height="1.0" width="726.0" styleClass="divider" />

                        <VBox fx:id="valuesBox" spacing="14.0">
                            <children>
                                <Label text="What We Care About" styleClass="section-title" />

                                <VBox spacing="10.0" styleClass="value-block">
                                    <children>
                                        <Label text="1. Accuracy" styleClass="value-title" />
                                        <Label text="Reliable login, exam data, and outcomes so users can trust the system every time."
                                               wrapText="true" styleClass="value-text" />
                                    </children>
                                </VBox>

                                <VBox spacing="10.0" styleClass="value-block">
                                    <children>
                                        <Label text="2. Simplicity" styleClass="value-title" />
                                        <Label text="Clean flows for taking tests, reviewing progress, and managing exam operations without confusion."
                                               wrapText="true" styleClass="value-text" />
                                    </children>
                                </VBox>

                                <VBox spacing="10.0" styleClass="value-block">
                                    <children>
                                        <Label text="3. Momentum" styleClass="value-title" />
                                        <Label text="A focused interface with smooth motion that feels alive but never distracting."
                                               wrapText="true" styleClass="value-text" />
                                    </children>
                                </VBox>

                                <VBox spacing="10.0" styleClass="value-block">
                                    <children>
                                        <Label text="4. Future Vision" styleClass="value-title" />
                                        <Label text="This section is intentionally left spacious so the team can add milestones, goals, and project story updates later."
                                               wrapText="true" styleClass="value-text" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Region prefHeight="8.0" />
                        <Label text="Version 1.0 | CSE-108 Project Team" styleClass="footer-note" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
