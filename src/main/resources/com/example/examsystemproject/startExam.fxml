                                        mnemonicParsing="false"
                                        styleClass="practice-btn"
                                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 9 16 9 16; -fx-max-width: Infinity;"
                                        maxWidth="Infinity"/>
                            </VBox>

                            <!-- Practice Card: OOP -->
                            <VBox styleClass="practice-card"
                                  style="-fx-background-color: #1a3352; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 2);"
                                  spacing="10.0" HBox.hgrow="ALWAYS">
                                <Label text="☕" style="-fx-font-size: 28;"/>
                                <Label text="Object Oriented Programming"
                                       style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                                <Label text="Classes, Inheritance, Polymorphism &amp; Design"
                                       style="-fx-text-fill: #7a9abf; -fx-font-size: 11; -fx-wrap-text: true;"/>
                                <HBox spacing="10.0">
                                    <Label text="90 Q's" style="-fx-text-fill: #4ade80; -fx-font-size: 11; -fx-background-color: rgba(74,222,128,0.15); -fx-padding: 3 8 3 8; -fx-background-radius: 10;"/>
                                    <Label text="MCQ" style="-fx-text-fill: #f59e0b; -fx-font-size: 11; -fx-background-color: rgba(245,158,11,0.15); -fx-padding: 3 8 3 8; -fx-background-radius: 10;"/>
                                </HBox>
                                <Button text="Practice Now →"
                                        onAction="#onPracticeExam"
                                        mnemonicParsing="false"
                                        styleClass="practice-btn"
                                        style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 9 16 9 16; -fx-max-width: Infinity;"
                                        maxWidth="Infinity"/>
                            </VBox>

                            <!-- Practice Card: Database -->
                            <VBox styleClass="practice-card"
                                  style="-fx-background-color: #1a3352; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 2);"
                                  spacing="10.0" HBox.hgrow="ALWAYS">
                                <Label text="🗄" style="-fx-font-size: 28;"/>
                                <Label text="Database Management"
                                       style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                                <Label text="SQL, Normalization, ER Diagrams &amp; Queries"
                                       style="-fx-text-fill: #7a9abf; -fx-font-size: 11; -fx-wrap-text: true;"/>
                                <HBox spacing="10.0">
