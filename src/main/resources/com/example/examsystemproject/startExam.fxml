<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Line?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.examsystemproject.StartExamController"
            prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: #0f1b2d;">
    <stylesheets>
        <URL value="@Dashboard.css" />
        <URL value="@startExam.css" />
    </stylesheets>

    <!-- ── TOP HEADER BAR ── -->
    <AnchorPane prefHeight="70.0" prefWidth="1000.0"
                style="-fx-background-color: #1e3a5f; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 8, 0, 0, 3);">
        <children>
            <!-- Logo -->
            <ImageView fitHeight="50.0" fitWidth="50.0" layoutX="15.0" layoutY="10.0" preserveRatio="true">
                <image><Image url="@../../../prlogo.png"/></image>
            </ImageView>

            <!-- App Title -->
            <Label layoutX="75.0" layoutY="18.0"
                   text="ExamAce - Exam Portal"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>

            <!-- Back to Dashboard button -->
            <Button layoutX="850.0" layoutY="20.0"
                    onAction="#onBackToDashboard"
                    mnemonicParsing="false"
                    text="← Dashboard"
                    styleClass="back-btn"
                    style="-fx-background-color: #2d5a8c; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 18 8 18;"/>
        </children>
    </AnchorPane>

    <!-- ── PAGE CONTENT ── -->
