                                <Label text="Data Structures"
                                       style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                                <Label text="Arrays, Trees, Graphs, Sorting &amp; more"
                                       style="-fx-text-fill: #7a9abf; -fx-font-size: 11; -fx-wrap-text: true;"/>
                                <HBox spacing="10.0">
                                    <Label text="120 Q's" style="-fx-text-fill: #4ade80; -fx-font-size: 11; -fx-background-color: rgba(74,222,128,0.15); -fx-padding: 3 8 3 8; -fx-background-radius: 10;"/>
                                    <Label text="Mixed" style="-fx-text-fill: #60a5fa; -fx-font-size: 11; -fx-background-color: rgba(96,165,250,0.15); -fx-padding: 3 8 3 8; -fx-background-radius: 10;"/>
