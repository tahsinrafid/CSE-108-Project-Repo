                <Label text="📋  Exam Centre"
                       style="-fx-text-fill: #e8f0fe; -fx-font-size: 24; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                <Label text="Choose to sit for a scheduled exam or sharpen your skills with practice tests."
                       style="-fx-text-fill: #8aaed6; -fx-font-size: 13; -fx-font-family: 'Segoe UI';"/>

                <!-- ═══════════════════════════════════════════
                     DUE EXAMINATIONS SECTION
                     ═══════════════════════════════════════════ -->
                <VBox spacing="14.0" styleClass="section-box"
                      style="-fx-background-color: #162844; -fx-background-radius: 12; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 12, 0, 0, 4);">
                    <children>

                        <!-- Section Title Row -->
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <Label text="🔴" style="-fx-font-size: 18;"/>
                            <Label text="Due Examinations"
                                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 18; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="dueExamCountLabel" text="3 pending"
                                   style="-fx-text-fill: #ff9f9f; -fx-font-size: 12; -fx-background-color: rgba(255,107,107,0.18); -fx-padding: 4 10 4 10; -fx-background-radius: 20;"/>
                        </HBox>

                        <Label text="Scheduled exams assigned by your instructor. Complete before deadline."
                               style="-fx-text-fill: #8aaed6; -fx-font-size: 12; -fx-font-family: 'Segoe UI';"/>

                        <!-- Divider -->
                        <Region prefHeight="6.0"/>

                        <!-- Due Exam Card 1 -->
                        <HBox styleClass="exam-card due-card"
                              style="-fx-background-color: #1e3a5f; -fx-background-radius: 10; -fx-padding: 18 22 18 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 2);"
                              alignment="CENTER_LEFT" spacing="16.0">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Data Structures &amp; Algorithms – Mid Term"
                                           style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                                    <HBox spacing="20.0">
                                        <Label text="📅  Due: March 16, 2026  |  2:00 PM"
                                               style="-fx-text-fill: #ff9f9f; -fx-font-size: 12;"/>
                                        <Label text="⏱  Duration: 60 min"
                                               style="-fx-text-fill: #8aaed6; -fx-font-size: 12;"/>
                                        <Label text="❓  40 Questions"
                                               style="-fx-text-fill: #8aaed6; -fx-font-size: 12;"/>
                                    </HBox>
                                    <Label text="Course: CSE 201  •  Instructor: Dr. Rahman"
                                           style="-fx-text-fill: #607d9e; -fx-font-size: 11;"/>
                                </VBox>
                                <Label text="URGENT" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 4 8 4 8; -fx-background-radius: 4;"/>
                                <Button text="Sit for Exam"
                                        onAction="#onSitForExam"
                                        mnemonicParsing="false"
                                        styleClass="exam-start-btn due-start-btn"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 22 10 22;"/>
                            </children>
                        </HBox>

                        <!-- Due Exam Card 2 -->
                        <HBox styleClass="exam-card due-card"
                              style="-fx-background-color: #1e3a5f; -fx-background-radius: 10; -fx-padding: 18 22 18 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 2);"
                              alignment="CENTER_LEFT" spacing="16.0">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label text="Database Management – Quiz 3"
                                           style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                                    <HBox spacing="20.0">
                                        <Label text="📅  Due: March 18, 2026  |  11:59 PM"
                                               style="-fx-text-fill: #ffa07a; -fx-font-size: 12;"/>
                                        <Label text="⏱  Duration: 30 min"
                                               style="-fx-text-fill: #8aaed6; -fx-font-size: 12;"/>
                                        <Label text="❓  20 Questions"
                                               style="-fx-text-fill: #8aaed6; -fx-font-size: 12;"/>
                                    </HBox>
                                    <Label text="Course: CSE 301  •  Instructor: Dr. Hossain"
                                           style="-fx-text-fill: #607d9e; -fx-font-size: 11;"/>
                                </VBox>
                                <Label text="DUE SOON" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 4 8 4 8; -fx-background-radius: 4;"/>
                                <Button text="Sit for Exam"
                                        onAction="#onSitForExam"
                                        mnemonicParsing="false"
                                        styleClass="exam-start-btn due-start-btn"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 10 22 10 22;"/>
                            </children>
                        </HBox>

                        <!-- Due Exam Card 3 -->
                        <HBox styleClass="exam-card due-card"
                              style="-fx-background-color: #1e3a5f; -fx-background-radius: 10; -fx-padding: 18 22 18 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 2);"
                              alignment="CENTER_LEFT" spacing="16.0">
                            <children>
