<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #080917;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.examsystemproject.DashBoardController">
    <stylesheets>
        <URL value="@Dashboard.css" />
    </stylesheets>
    <children>
        <!-- Header/Top Bar with Logo and Minimize Button -->
        <AnchorPane prefHeight="70.0" prefWidth="1000.0" style="-fx-background-color: #58eb34; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 5, 0, 0, 2);">
            <children>
                <!-- Logo Image -->
                <ImageView fitHeight="50.0" fitWidth="50.0" layoutX="15.0" layoutY="10.0" preserveRatio="true">
                    <image>
                        <Image url="@prlogo.png" />
                    </image>
                </ImageView>

                <!-- Title Text beside Logo -->
                <Label layoutX="75.0" layoutY="18.0" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="ExamAce - Exam portal [Teacher DashBoard]" />

            </children>
        </AnchorPane>

        <!-- Sidebar Navigation -->
        <VBox fx:id="sidebarVBox" layoutY="70.0" prefHeight="630.0" prefWidth="220.0" style="-fx-background-color: #3437eb; -fx-padding: 10px 0px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
            <children>
                <Button fx:id="dashboardBtn" mnemonicParsing="false" onAction="#onDashboardClick" style="-fx-padding: 15px 20px; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: #1e3a5f; -fx-border-color: #1e3a5f; -fx-cursor: hand;" styleClass="sidebar-btn-active" text="Dashboard" />
                <Button fx:id="questionBankBtn" mnemonicParsing="false" onAction="#onQuestionBankClick" style="-fx-padding: 15px 20px; -fx-text-fill: #d0d0d0; -fx-font-size: 13; -fx-background-color: Transparent; -fx-border-color: transparent; -fx-cursor: hand;" styleClass="sidebar-btn" text="Question Bank">
               <font>
                  <Font name="BijoyMJ Regular" size="18.0" />
               </font></Button>
                <Button fx:id="speedTestBtn" mnemonicParsing="false" onAction="#onViewStudentClick" style="-fx-padding: 15px 20px; -fx-text-fill: #d0d0d0; -fx-font-size: 13; -fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;" styleClass="sidebar-btn" text="View students" />
                <Button fx:id="leaderboardBtn" mnemonicParsing="false" onAction="#onLeaderboardClick" style="-fx-padding: 15px 20px; -fx-text-fill: #d0d0d0; -fx-font-size: 13; -fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;" styleClass="sidebar-btn" text="Leaderboard" />
                <Button fx:id="communityBtn" mnemonicParsing="false" onAction="#onTakeExamClick" style="-fx-padding: 15px 20px; -fx-text-fill: #d0d0d0; -fx-font-size: 13; -fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;" styleClass="sidebar-btn" text="Take exam" />
                <Button fx:id="qnaBtn" mnemonicParsing="false" onAction="#OnMessegesClick" style="-fx-padding: 15px 20px; -fx-text-fill: #d0d0d0; -fx-font-size: 13; -fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;" styleClass="sidebar-btn" text="Messeges" />
                <Button fx:id="aboutUsBtn" mnemonicParsing="false" onAction="#onAboutUsClick" style="-fx-padding: 15px 20px; -fx-text-fill: #d0d0d0; -fx-font-size: 13; -fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;" styleClass="sidebar-btn" text="About us" />
            <Button fx:id="LogOutBtn" layoutX="10.0" layoutY="328.0" mnemonicParsing="false" onAction="#logout" style="-fx-padding: 15px 20px; -fx-text-fill: red; -fx-font-size: 13; -fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand;" styleClass="sidebar-btn" text="Log out" />
            </children>
        </VBox>

        <!-- Main Content Area -->
        <!-- Card 1: Dashboard -->
        <AnchorPane layoutX="240.0" layoutY="90.0" prefHeight="165.0" prefWidth="215.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-border-radius: 5; -fx-background-radius: 5;">
            <children>
                <Label layoutX="12.0" layoutY="12.0" style="-fx-text-fill: #1e3a5f; -fx-font-size: 13; -fx-font-weight: bold;" text="Take Exam" />
                <Button layoutX="57.0" layoutY="115.0" mnemonicParsing="false" onAction="#onViewSubClick" prefHeight="30.0" prefWidth="101.0" style="-fx-padding: 8px 20px; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-color: green; -fx-text-fill: white; -fx-background-radius: 3; -fx-cursor: hand;" text="View subject" />
            </children>
        </AnchorPane>

        <!-- Card 2: Question Bank -->
        <AnchorPane layoutX="475.0" layoutY="90.0" prefHeight="165.0" prefWidth="215.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-border-radius: 5; -fx-background-radius: 5;">
            <children>
                <Label layoutX="12.0" layoutY="12.0" style="-fx-text-fill: #1e3a5f; -fx-font-size: 13; -fx-font-weight: bold;" text="Question Bank" />
                <Button layoutX="57.0" layoutY="115.0" mnemonicParsing="false" onAction="#onQuestionBankViewClick" prefHeight="30.0" prefWidth="101.0" style="-fx-padding: 8px 20px; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-color: #2d5a8c; -fx-text-fill: white; -fx-background-radius: 3; -fx-cursor: hand;" text="View" />
            </children>
        </AnchorPane>

        <!-- Card 3: Speed test -->
        <AnchorPane layoutX="710.0" layoutY="90.0" prefHeight="165.0" prefWidth="215.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-border-radius: 5; -fx-background-radius: 5;">
            <children>
                <Label layoutX="12.0" layoutY="12.0" style="-fx-text-fill: #1e3a5f; -fx-font-size: 13; -fx-font-weight: bold;" text="View Students" />
                <Button layoutX="57.0" layoutY="115.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="101.0" style="-fx-padding: 8px 20px; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-color: magenta; -fx-text-fill: white; -fx-background-radius: 3; -fx-cursor: hand;" text="View" />
            </children>
        </AnchorPane>

        <!-- Card 4: Leaderboard -->
        <AnchorPane layoutX="240.0" layoutY="275.0" prefHeight="165.0" prefWidth="215.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-border-radius: 5; -fx-background-radius: 5;">
            <children>
                <Label layoutX="12.0" layoutY="12.0" style="-fx-text-fill: #1e3a5f; -fx-font-size: 13; -fx-font-weight: bold;" text="Leaderboard" />
                <Button layoutX="57.0" layoutY="115.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="101.0" style="-fx-padding: 8px 20px; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-color: #f59c1a; -fx-text-fill: white; -fx-background-radius: 3; -fx-cursor: hand;" text="View" />
            </children>
        </AnchorPane>

        <!-- Card 5: Community -->
        <AnchorPane layoutX="475.0" layoutY="275.0" prefHeight="165.0" prefWidth="215.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-border-radius: 5; -fx-background-radius: 5;">
            <children>
                <Label layoutX="12.0" layoutY="12.0" style="-fx-text-fill: #1e3a5f; -fx-font-size: 13; -fx-font-weight: bold;" text="Routine" />
                <Button layoutX="57.0" layoutY="115.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="101.0" style="-fx-padding: 8px 20px; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-color: #33a86f; -fx-text-fill: white; -fx-background-radius: 3; -fx-cursor: hand;" text="set" />
            </children>
        </AnchorPane>

        <!-- Card 6: QNA -->
        <AnchorPane layoutX="710.0" layoutY="275.0" prefHeight="165.0" prefWidth="215.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-border-radius: 5; -fx-background-radius: 5;">
            <children>
                <Label layoutX="12.0" layoutY="12.0" style="-fx-text-fill: #1e3a5f; -fx-font-size: 13; -fx-font-weight: bold;" text="Messeges" />
                <Button layoutX="57.0" layoutY="115.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="101.0" style="-fx-padding: 8px 20px; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-color: #9c27b0; -fx-text-fill: white; -fx-background-radius: 3; -fx-cursor: hand;" text="View" />
            </children>
        </AnchorPane>

        <!-- Statistics Chart -->
        <AnchorPane layoutX="240.0" layoutY="460.0" prefHeight="190.0" prefWidth="685.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2); -fx-border-radius: 5; -fx-background-radius: 5;">
            <children>
                <Label layoutX="15.0" layoutY="12.0" style="-fx-text-fill: #1e3a5f; -fx-font-size: 14; -fx-font-weight: bold;" text="Student performance overview" />
                <AreaChart layoutX="15.0" layoutY="40.0" prefHeight="135.0" prefWidth="655.0" style="-fx-background-color: transparent;">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" />
                    </yAxis>
                </AreaChart>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
