<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #080917;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.examsystemproject.CreateExamController">
    <stylesheets>
        <URL value="@Dashboard.css" />
    </stylesheets>

    <top>
        <AnchorPane prefHeight="70.0" prefWidth="900.0" style="-fx-background-color: #58eb34; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 3);">
            <ImageView fitHeight="50.0" fitWidth="50.0" layoutX="15.0" layoutY="10.0" preserveRatio="true">
                <image>
                    <Image url="@../../../prlogo.png" />
                </image>
            </ImageView>
            <Label layoutX="75.0" layoutY="20.0" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="ExamAce - Create Exam" />
            <HBox spacing="10.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="19.0">
                <Button mnemonicParsing="false" onAction="#goBack" prefHeight="32.0" prefWidth="82.0" style="-fx-background-color: rgba(0,0,0,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 13;" text="Back" />
            </HBox>
        </AnchorPane>
    </top>

    <center>
        <VBox spacing="12.0" style="-fx-background-color: #080917; -fx-padding: 14 20 16 20;">
            <AnchorPane prefHeight="120.0" style="-fx-background-color: #0f1225; -fx-background-radius: 10; -fx-border-color: #1f2445; -fx-border-radius: 10; -fx-padding: 12;">
                <children>
                    <Label layoutX="16.0" layoutY="12.0" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;" text="Exam Details" />

                    <Label layoutX="16.0" layoutY="45.0" style="-fx-text-fill: #b8bdd2; -fx-font-size: 12;" text="Exam Name" />
                    <TextField fx:id="examNameField" layoutX="16.0" layoutY="64.0" prefHeight="34.0" prefWidth="240.0" promptText="Midterm Test" style="-fx-background-color: #1a1f3c; -fx-text-fill: white; -fx-prompt-text-fill: #747b9a; -fx-border-color: #2a315c; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13;" />

                    <Label layoutX="276.0" layoutY="45.0" style="-fx-text-fill: #b8bdd2; -fx-font-size: 12;" text="Subject" />
                    <TextField fx:id="subjectField" layoutX="276.0" layoutY="64.0" prefHeight="34.0" prefWidth="190.0" promptText="Physics" style="-fx-background-color: #1a1f3c; -fx-text-fill: white; -fx-prompt-text-fill: #747b9a; -fx-border-color: #2a315c; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13;" />

                    <Label layoutX="486.0" layoutY="45.0" style="-fx-text-fill: #b8bdd2; -fx-font-size: 12;" text="Duration (minutes)" />
                    <TextField fx:id="durationField" layoutX="486.0" layoutY="64.0" prefHeight="34.0" prefWidth="135.0" promptText="60" style="-fx-background-color: #1a1f3c; -fx-text-fill: white; -fx-prompt-text-fill: #747b9a; -fx-border-color: #2a315c; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13;" />

                    <Region layoutX="640.0" layoutY="64.0" prefHeight="34.0" prefWidth="110.0" />
                    <Label fx:id="selectedCountLabel" layoutX="640.0" layoutY="72.0" style="-fx-text-fill: #58eb34; -fx-font-size: 13; -fx-font-weight: bold;" text="0 selected" />

                    <Button fx:id="saveExamBtn" layoutX="760.0" layoutY="64.0" mnemonicParsing="false" onAction="#saveExam" prefHeight="34.0" prefWidth="110.0" styleClass="card-btn-success" text="Save Exam" />
                </children>
            </AnchorPane>

            <HBox alignment="CENTER_LEFT" prefHeight="40.0" style="-fx-background-color: #0f1225; -fx-border-color: #1f2445; -fx-border-width: 1 0 1 0; -fx-padding: 0 12;">
                <Label style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="Question Bank" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #8188a8; -fx-font-size: 12;" text="Select questions to include" />
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="questionsContainer" spacing="10.0">
                        <padding>
                            <Insets bottom="14.0" top="8.0" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
