<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="600.0" maxWidth="900.0" minHeight="600.0" minWidth="900.0" prefHeight="600.0" prefWidth="900.0" styleClass="dashboard-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.examsystemproject.QnaController">
    <stylesheets>
        <URL value="@Dashboard.css" />
    </stylesheets>

    <children>
        <AnchorPane prefHeight="70.0" prefWidth="900.0" styleClass="dash-top-bar">
            <children>
                <ImageView fitHeight="50.0" fitWidth="50.0" layoutX="15.0" layoutY="10.0" preserveRatio="true">
                    <image>
                        <Image url="@prlogo.png" />
                    </image>
                </ImageView>
                <Label layoutX="80.0" layoutY="18.0" styleClass="dash-title" text="Community" />
                <Button layoutX="630.0" layoutY="18.0" mnemonicParsing="false" onAction="#onOpenQuestionModal" prefHeight="34.0" prefWidth="140.0" styleClass="qna-header-post-btn" text="Post Questions" />
                <Button layoutX="782.0" layoutY="18.0" mnemonicParsing="false" onAction="#onBack" prefHeight="34.0" prefWidth="90.0" styleClass="menu-toggle-btn" text="Back" />
            </children>
        </AnchorPane>

        <VBox layoutX="24.0" layoutY="86.0" prefWidth="852.0" spacing="10.0">
            <VBox spacing="10.0" styleClass="qna-feed-card">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="qna-card-title" text="Public questions" />
                    <Region prefWidth="1.0" HBox.hgrow="ALWAYS" />
                    <Label fx:id="postCountLabel" styleClass="qna-count-label" text="0 questions" />
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="474.0" styleClass="qna-feed-scroll" vbarPolicy="AS_NEEDED">
                    <content>
                        <VBox fx:id="postContainer" spacing="10.0" style="-fx-padding: 4 4 14 4;" />
                    </content>
                </ScrollPane>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
