<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #eef0f6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.examsystemproject.ViewResultsController">
    <stylesheets>
        <URL value="@Dashboard.css" />
    </stylesheets>

    <children>
        <AnchorPane prefHeight="78.0" prefWidth="900.0" style="-fx-background-color: #3d2b69; -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0;">
            <children>
                <ImageView fitHeight="48.0" fitWidth="48.0" layoutX="18.0" layoutY="15.0" preserveRatio="true">
                    <image>
                        <Image url="@prlogo.png" />
                    </image>
                </ImageView>
                <Label layoutX="295.0" layoutY="21.0" style="-fx-text-fill: #f5f3ff; -fx-font-size: 40; -fx-font-weight: bold; -fx-font-family: 'Trebuchet MS';" text="View Results" />
                <Button layoutX="798.0" layoutY="21.0" mnemonicParsing="false" onAction="#onBack" prefHeight="34.0" prefWidth="84.0" styleClass="menu-toggle-btn" text="Back" />
            </children>
        </AnchorPane>

        <AnchorPane layoutX="20.0" layoutY="94.0" prefHeight="486.0" prefWidth="860.0" style="-fx-background-color: rgba(255, 255, 255, 0.92); -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: rgba(47, 38, 70, 0.15);">
            <children>
                <Label layoutX="26.0" layoutY="18.0" style="-fx-text-fill: #2f2349; -fx-font-size: 22; -fx-font-weight: bold; -fx-font-family: 'Trebuchet MS';" text="Your Exam Attempts" />
                <Label layoutX="26.0" layoutY="48.0" style="-fx-text-fill: #6d6780; -fx-font-size: 12; -fx-font-family: 'Trebuchet MS';" text="Review your past exam submissions" />

                <HBox layoutX="22.0" layoutY="74.0" prefHeight="36.0" prefWidth="816.0" style="-fx-background-color: #3d2b69; -fx-background-radius: 8 8 0 0; -fx-padding: 0 12 0 12;" spacing="8.0">
                    <children>
                        <Label prefWidth="200.0" style="-fx-text-fill: #ffffff; -fx-font-size: 12; -fx-font-weight: bold; -fx-font-family: 'Trebuchet MS';" text="Exam Name" />
                        <Label prefWidth="120.0" style="-fx-text-fill: #ffffff; -fx-font-size: 12; -fx-font-weight: bold; -fx-font-family: 'Trebuchet MS';" text="Class" />
                        <Label prefWidth="120.0" style="-fx-text-fill: #ffffff; -fx-font-size: 12; -fx-font-weight: bold; -fx-font-family: 'Trebuchet MS';" text="Marks" />
                        <Label prefWidth="150.0" style="-fx-text-fill: #ffffff; -fx-font-size: 12; -fx-font-weight: bold; -fx-font-family: 'Trebuchet MS';" text="Submitted" />
                        <Label prefWidth="90.0" style="-fx-text-fill: #ffffff; -fx-font-size: 12; -fx-font-weight: bold; -fx-font-family: 'Trebuchet MS';" text="Action" />
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutX="22.0" layoutY="110.0" prefHeight="362.0" prefWidth="816.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: #e1dce9; -fx-border-width: 0 1 1 1; -fx-border-radius: 0 0 8 8;">
                    <content>
                        <VBox fx:id="resultsList" spacing="8.0" style="-fx-background-color: #f7f6fb; -fx-padding: 10;" />
                    </content>
                </ScrollPane>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>

